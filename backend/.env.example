# Copy to .env and fill in.

# Postgres connection string. The docker-compose service uses these credentials.
DATABASE_URL=postgres://uptime:uptime@localhost:5433/uptime

# Port the Express server listens on. Defaults to 4000 if unset.
PORT=4000

# --- Email config ---
# Pick ONE of the two blocks below.

# Block A: dev with mailhog (recommended for local). Web UI at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025

# Block B: real Gmail (uncomment and fill in for actual alerts).
# For Gmail, EMAIL_PASS must be an App Password (not your account password).
# EMAIL_USER=
# EMAIL_PASS=
